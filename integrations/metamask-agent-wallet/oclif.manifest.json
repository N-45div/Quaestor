{
  "commands": {
    "quaestor:buy": {
      "aliases": [],
      "args": {
        "stock": {
          "description": "Token to buy, such as tTSLA",
          "name": "stock",
          "required": true
        },
        "amount": {
          "description": "Dollars to spend from the governor, such as 2",
          "name": "amount",
          "required": true
        }
      },
      "description": "Buy a token through your Quaestor governor: the owner's caps, limit prices and Chainlink guard are enforced on-chain, and MetaMask signs",
      "examples": [
        "mm quaestor buy tTSLA 2 --reason \"TSLA dipped under my entry\"",
        "mm quaestor buy tTSLA 2 --reason \"test\" --dry-run"
      ],
      "flags": {
        "format": {
          "char": "f",
          "description": "Output format: text | json | toon (defaults to text in TTY, json when piped)",
          "name": "format",
          "hasDynamicHelp": false,
          "multiple": false,
          "options": [
            "text",
            "json",
            "toon"
          ],
          "type": "option"
        },
        "json": {
          "description": "Shorthand for --format=json",
          "name": "json",
          "allowNo": false,
          "type": "boolean"
        },
        "toon": {
          "description": "Shorthand for --format=toon",
          "name": "toon",
          "allowNo": false,
          "type": "boolean"
        },
        "verbose": {
          "char": "v",
          "description": "Show debug logs on stderr. Use this for troubleshooting",
          "name": "verbose",
          "allowNo": false,
          "type": "boolean"
        },
        "stock": {
          "description": "Token to buy, such as tTSLA",
          "name": "stock",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "amount": {
          "description": "Dollars to spend from the governor, such as 2",
          "name": "amount",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "reason": {
          "description": "Why, in a sentence; its hash is committed on-chain with the trade",
          "name": "reason",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "slippage": {
          "description": "Floor below the quote, in basis points (default 100)",
          "name": "slippage",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "min-out": {
          "description": "Exact floor in tokens, instead of --slippage",
          "name": "min-out",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "dry-run": {
          "description": "Check and simulate only; send nothing",
          "name": "dry-run",
          "allowNo": false,
          "type": "boolean"
        },
        "network": {
          "description": "Quaestor network: monad-testnet, robinhood-testnet or robinhood",
          "name": "network",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "rpc": {
          "description": "RPC for reads (default: the network's public one)",
          "name": "rpc",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "governor": {
          "description": "Governor address, when more than one names this wallet",
          "name": "governor",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        }
      },
      "hasDynamicHelp": false,
      "hiddenAliases": [],
      "id": "quaestor:buy",
