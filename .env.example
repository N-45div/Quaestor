# --- deployment -------------------------------------------------------------
# Deployer / owner key (fund with testnet OKB: https://web3.okx.com/xlayer/faucet)
PRIVATE_KEY=
# Optional RPC overrides
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech
XLAYER_RPC=https://rpc.xlayer.tech
# Liquidity seeded per pool at deploy time (in OKB)
SEED_NATIVE_QUSD=0.2
SEED_NATIVE_QBTC=0.2

# --- agent runtime ----------------------------------------------------------
# The agent's operator key (NOT the owner key — that's the whole point)
OPERATOR_KEY=
# Agent id assigned at registration
AGENT_ID=1
# Where the Quaestor stack lives (defaults to deployments/<network>.json)
QUAESTOR_ADDRESS=
DEX_ADDRESS=
QUSD_ADDRESS=
# Paid oracle endpoint + the address it collects DATA payments at
ORACLE_URL=http://localhost:8402
# Where the agent publishes decision records for third-party verification
DECISION_LEDGER_URL=http://localhost:8402
# LLM reasoning (optional; agent falls back to deterministic DCA without it)
OPENROUTER_API_KEY=
# Address that accumulates on-chain INFERENCE metering payments
INFERENCE_SINK=

# --- guardian watchdog ------------------------------------------------------
# Key for the guardian role: the chain lets it ONLY suspend. Arm by setting it
# and appointing its address via setGuardian (dashboard or script).
GUARDIAN_KEY=
GUARDIAN_BURST_N=6
GUARDIAN_BURST_WINDOW_S=60
# Run the example agent inside services/main.ts (Render single-process mode)
RUN_AGENT=0

# --- standard-x402 lane (optional) ------------------------------------------
# Serves the oracle signal over the x402 Payment Protocol at /x402/signal via
# OKX's facilitator, alongside the governed lane. Needs an OKX developer
# project's API credentials; stays off without them.
X402_ENABLED=0
X402_NETWORK=eip155:1952
X402_PRICE=$0.01
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# --- oracle service ---------------------------------------------------------
# Price per signal in OKB and the address payments must arrive at
ORACLE_PRICE_OKB=0.001
ORACLE_COLLECTOR_ADDRESS=
ORACLE_PORT=8402

# --- Hedera lane (ETHOnline 2026) -------------------------------------------
# Hardhat deploys to Hedera testnet (chain id 296) with this ECDSA key; the
# services process settles x402 payments to HEDERA_PAYTO_ACCOUNT_ID through the
# Blocky402 facilitator. Create the account at https://portal.hedera.com —
# use the portal, not the faucet: the x402 signer needs a real 0.0.x id.
HEDERA_TESTNET_RPC=https://testnet.hashio.io/api
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
# Where paid Hedera requests settle (a Hedera account id, e.g. 0.0.1234).
HEDERA_PAYTO_ACCOUNT_ID=
# Hedera MAINNET (chain id 295) — a funded ECDSA account; real HBAR.
HEDERA_MAINNET_RPC=https://mainnet.hashio.io/api
HEDERA_MAINNET_PRIVATE_KEY=
X402_HEDERA_ENABLED=0
BLOCKY402_URL=https://api.testnet.blocky402.com

# --- Arc (Circle) lane (ETHOnline 2026) -------------------------------------
# USDC is Arc's gas token, so the governor deploys unchanged and every cap is
# a dollar cap. Fund the deployer at https://faucet.circle.com (testnet).
ARC_TESTNET_RPC=https://rpc.testnet.arc.io
ARC_PRIVATE_KEY=
# Arc mainnet launches 16 Sep 2026 — fill these then; the `arc` network appears
# in hardhat.config.ts only when both are set.
ARC_RPC=
ARC_CHAIN_ID=
