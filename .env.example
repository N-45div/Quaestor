# --- deployment -------------------------------------------------------------
# Deployer / owner key (fund with testnet OKB: https://web3.okx.com/xlayer/faucet)
PRIVATE_KEY=
# Optional RPC overrides
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech
XLAYER_RPC=https://rpc.xlayer.tech
# Liquidity seeded per pool at deploy time (in OKB)
SEED_NATIVE_QUSD=0.2
SEED_NATIVE_QBTC=0.2

# --- agent runtime ----------------------------------------------------------
# The agent's operator key (NOT the owner key — that's the whole point)
OPERATOR_KEY=
# Agent id assigned at registration
AGENT_ID=1
# Where the Quaestor stack lives (defaults to deployments/<network>.json)
QUAESTOR_ADDRESS=
DEX_ADDRESS=
QUSD_ADDRESS=
# Paid oracle endpoint + the address it collects DATA payments at
ORACLE_URL=http://localhost:8402
# LLM reasoning (optional; agent falls back to deterministic DCA without it)
OPENROUTER_API_KEY=
# Address that accumulates on-chain INFERENCE metering payments
INFERENCE_SINK=

# --- oracle service ---------------------------------------------------------
# Price per signal in OKB and the address payments must arrive at
ORACLE_PRICE_OKB=0.001
ORACLE_COLLECTOR_ADDRESS=
ORACLE_PORT=8402
