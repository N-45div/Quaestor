{
  "name": "quaestor",
  "version": "0.1.0",
  "private": true,
  "description": "Quaestor \u2014 the on-chain spend governor for AI agents on X Layer. Don't give your agent a wallet; give it an allowance.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:xlayer-testnet": "hardhat run scripts/deploy.ts --network xlayerTestnet",
    "services": "ts-node services/main.ts",
    "agent": "ts-node agent/index.ts",
    "mcp": "ts-node mcp/server.ts",
    "mcp:smoke": "ts-node mcp/smoke.ts",
    "deploy:arc-testnet": "hardhat run scripts/deploy.ts --network arcTestnet",
    "deploy:hedera-testnet": "hardhat run scripts/deploy.ts --network hederaTestnet",
    "deploy:render": "ts-node scripts/render-deploy.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@okxweb3/x402-core": "^0.1.0",
    "@okxweb3/x402-evm": "^0.2.1",
    "@okxweb3/x402-express": "^0.1.1",
    "@x402/core": "^2.25.0",
    "@x402/express": "^2.25.0",
    "@x402/extensions": "^2.25.0",
    "@x402/fetch": "^2.25.0",
    "@x402/hedera": "^2.25.0",
    "ethers": "^6.13.0",
    "express": "^4.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/express": "^4.17.21",
    "dotenv": "^16.4.5",
    "hardhat": "^2.26.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
