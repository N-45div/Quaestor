{
  "name": "quaestor",
  "version": "0.1.0",
  "private": true,
  "description": "Quaestor — the on-chain spend governor for AI agents, on Solana and EVM chains. Don't give your agent a wallet; give it an allowance.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:xlayer-testnet": "hardhat run scripts/deploy.ts --network xlayerTestnet",
    "services": "ts-node services/main.ts",
    "quaestor": "ts-node cli/quaestor.ts",
    "build:cli": "node cli/build.mjs",
    "agent": "ts-node agent/index.ts",
    "mcp": "ts-node mcp/server.ts",
    "mcp:smoke": "ts-node mcp/smoke.ts",
    "deploy:arc-testnet": "hardhat run scripts/deploy.ts --network arcTestnet",
    "deploy:hedera-testnet": "hardhat run scripts/deploy.ts --network hederaTestnet",
    "deploy:render": "ts-node scripts/render-deploy.ts",
    "deploy:hedera-mainnet": "hardhat run scripts/deploy.ts --network hederaMainnet",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:base-sepolia": "hardhat run scripts/deploy.ts --network baseSepolia",
    "deploy:attested": "hardhat run scripts/deploy-attested.ts --network creditcoinTestnet",
    "attest": "ts-node scripts/attest-once.ts",
    "hedera:preflight": "ts-node scripts/hedera-preflight.ts",
    "hedera:pay": "ts-node scripts/pay-hedera.ts",
    "prove:caps": "hardhat run scripts/prove-caps.ts",
    "arc:preflight": "ts-node scripts/arc-preflight.ts",
    "deploy:arc-mainnet": "hardhat run scripts/deploy.ts --network arc",
    "deploy:base-mainnet": "hardhat run scripts/deploy.ts --network base",
    "stocks:day1": "ts-node scripts/stocks-day1.ts",
    "stocks:preflight": "ts-node scripts/stocks-preflight.ts",
    "stocks:prestocks:preflight": "ts-node scripts/prestocks-preflight.ts",
    "stocks:rules": "ts-node agent/stocks-rules.ts",
    "stocks:llm": "ts-node agent/stocks-llm.ts",
    "stocks:solana:validator": "wsl bash solana/tests/validator.sh",
    "stocks:solana:test": "mocha --require ts-node/register solana/tests/*.test.ts",
    "mcp:stocks": "ts-node mcp/stocks-server.ts",
    "mcp:probe": "ts-node scripts/mcp-http-probe.ts",
    "intel:pay": "ts-node scripts/intel-pay.ts",
    "services:stocks": "ts-node services/stocks-main.ts",
    "stocks:solana:devnet": "ts-node solana/scripts/devnet-demo.ts",
    "stocks:faucet:fund": "ts-node solana/scripts/faucet-devnet.ts",
    "stocks:x402:setup": "ts-node solana/scripts/x402-devnet-setup.ts",
    "stocks:x402:pay": "ts-node solana/scripts/x402-pay-demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@dynamic-labs-wallet/node-evm": "^1.1.29",
    "@dynamic-labs-wallet/node-svm": "1.1.14",
    "@gluwa/asc-contracts": "^0.2.1",
    "@gluwa/usc-sdk": "^0.18.0",
    "@meteora-ag/dynamic-bonding-curve-sdk": "^1.5.12",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@okxweb3/x402-core": "^0.1.0",
    "@okxweb3/x402-evm": "^0.2.1",
    "@okxweb3/x402-express": "^0.1.1",
    "@solana/kit": "^5.5.1",
    "@x402/core": "^2.26.0",
    "@x402/express": "^2.26.0",
    "@x402/extensions": "^2.26.0",
    "@x402/fetch": "^2.26.0",
    "@x402/hedera": "^2.26.0",
    "@x402/svm": "^2.26.0",
    "ethers": "^6.13.0",
    "express": "^4.19.0",
    "pg": "^8.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@e2b/desktop": "^2.4.0",
    "@electric-sql/pglite": "^0.5.8",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.23.1",
    "dotenv": "^16.4.5",
    "e2b": "^2.51.0",
    "hardhat": "^2.26.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
