{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    // ../solana/client.ts is shared with the validator suite; its imports
    // resolve here, so a host that installs only app/ can still type-check it.
    "paths": {
      "@solana/web3.js": ["./node_modules/@solana/web3.js"],
      "buffer": ["./node_modules/buffer"],
      "@noble/hashes/*": ["./node_modules/@noble/hashes/*"]
    }
  },
  "include": ["src"]
}
